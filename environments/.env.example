# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill it in:
#
#   cp environments/.env.example environments/.env.local
#
# `.env.local` is gitignored. It is the only place secrets belong locally.
#
# ON CI there is no `.env.local`. The four values marked SECRET below are
# supplied as repository secrets instead; everything else still comes from the
# committed `.env.<environment>` file.
#
# This works because a real environment variable always beats a file — see the
# note at the top of src/config/env.config.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your Salesforce org ──────────────────────────────────────────────────────
# Not secret. On CI these live in environments/.env.<environment>.
SF_INSTANCE_URL=https://your-org.develop.my.salesforce.com
SF_USERNAME=you@example.com

# ── SECRET — on CI these come from repository secrets ────────────────────────
# Password for SF_USERNAME. Only needed by the emailed-code login.
SF_PASSWORD=

# Consumer Key of the Connected App in Salesforce.
SF_CLIENT_ID=

# The contents of server.key. In .env.local put it on ONE line, quoted, with
# line breaks written as \n. In a GitHub secret, paste it with real line breaks.
#   SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
SF_PRIVATE_KEY=

# Gmail App Password from https://myaccount.google.com/apppasswords
# The normal Gmail password is rejected. Only needed by the emailed-code login.
SF_IMAP_PASSWORD=

# ── Reading the verification email ───────────────────────────────────────────
# Not secret. Turn on IMAP first: Gmail > Settings > Forwarding and POP/IMAP.
SF_IMAP_HOST=imap.gmail.com
SF_IMAP_PORT=993
SF_IMAP_USER=you@gmail.com

# ── Certificate login, optional overrides ────────────────────────────────────
# Leave blank unless told otherwise: both default to SF_INSTANCE_URL, which is
# what a Developer org needs.
SF_JWT_AUDIENCE=
SF_TOKEN_HOST=
